
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <style>
    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: "Helvetica Neue", Arial, sans-serif;
      color: #1f2937;
      font-size: 12px;
      line-height: 1.5;
      margin: 0;
    }

    header {
      border-bottom: 2px solid #4f46e5;
      padding-bottom: 12px;
      margin-bottom: 20px;
    }

    h1 {
      margin: 0;
      font-size: 22px;
      color: #4f46e5;
    }

    .meta {
      color: #6b7280;
      font-size: 11px;
      margin-top: 4px;
    }

    .stats {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
    }

    .stat {
      flex: 1;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 10px 12px;
    }

    .label {
      color: #6b7280;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .value {
      font-size: 18px;
      font-weight: 700;
      margin-top: 2px;
    }

    .bar {
      display: flex;
      height: 22px;
      border-radius: 6px;
      overflow: hidden;
      background: #f3f4f6;
      margin-bottom: 10px;
    }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      margin-bottom: 24px;
      font-size: 11px;
    }

    .dot {
      display: inline-block;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      margin-right: 5px;
    }

    .project {
      margin-bottom: 18px;
    }

    .project-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-left: 4px solid;
      padding-left: 10px;
      margin-bottom: 8px;
    }

    .project-head h2 {
      margin: 0;
      font-size: 14px;
    }

    .session {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 9px 12px;
      margin-bottom: 8px;
      page-break-inside: avoid;
    }

    .session-top {
      display: flex;
      justify-content: space-between;
      font-weight: 600;
    }

    .time {
      color: #6b7280;
      font-size: 10px;
      margin-top: 2px;
    }

    .notes {
      margin-top: 6px;
      color: #374151;
    }

    .notes p {
      margin: 0 0 4px;
    }

    .empty {
      color: #6b7280;
      padding: 40px 0;
      text-align: center;
    }

    @media print {
      .project {
        page-break-inside: avoid;
      }
    }
  </style>
</head>

<body>
  <% total = report[:total_duration].to_i %>

  <header>
    <h1>Daily Report</h1>

    <div class="meta">
      <%= report[:date].strftime("%A, %d %B %Y") %>
      ·
      Generated <%= generated_at.strftime("%d %b %Y, %H:%M") %>
      (<%= user.timezone %>)
    </div>
  </header>

  <% if report[:total_sessions].zero? %>

    <div class="empty">
      No work sessions recorded on this day.
    </div>

  <% else %>

    <!-- Summary statistics -->

    <div class="stats">
      <div class="stat">
        <div class="label">Total time</div>
        <div class="value">
          <%= PdfFormat.duration(total) %>
        </div>
      </div>

      <div class="stat">
        <div class="label">Sessions</div>
        <div class="value">
          <%= report[:total_sessions] %>
        </div>
      </div>

      <div class="stat">
        <div class="label">First start</div>
        <div class="value">
          <%= PdfFormat.clock(report[:first_session_start]) %>
        </div>
      </div>

      <div class="stat">
        <div class="label">Last end</div>
        <div class="value">
          <%= PdfFormat.clock(report[:last_session_end]) %>
        </div>
      </div>
    </div>

    <!-- Project distribution bar -->

    <div class="bar">
      <% report[:projects].each do |project| %>
        <div
          style="
            width: <%= PdfFormat.percent(project[:duration], total) %>%;
            background: <%= PdfFormat.color(project[:color]) %>;
          "
        ></div>
      <% end %>
    </div>

    <!-- Project legend -->

    <div class="legend">
      <% report[:projects].each do |project| %>
        <span>
          <span
            class="dot"
            style="background: <%= PdfFormat.color(project[:color]) %>;"
          ></span>

          <%= project[:name] %>
          ·
          <%= PdfFormat.duration(project[:duration]) %>
        </span>
      <% end %>
    </div>

    <!-- Project-wise sessions -->

    <% report[:projects].each do |project| %>
      <section class="project">

        <div
          class="project-head"
          style="border-color: <%= PdfFormat.color(project[:color]) %>;"
        >
          <h2><%= project[:name] %></h2>

          <strong>
            <%= PdfFormat.duration(project[:duration]) %>
          </strong>
        </div>

        <% project[:sessions].each do |session| %>
          <div class="session">

            <div class="session-top">
              <span>
                <%= session.intent.presence || "Work session" %>
              </span>

              <span>
                <%= PdfFormat.duration(session.duration) %>
              </span>
            </div>

            <div class="time">
              <%= PdfFormat.clock(session.started_at) %>
              –
              <%= PdfFormat.clock(session.ended_at, "ongoing") %>
            </div>

            <% if session.notes.present? %>
              <div class="notes">
                <%= simple_format(session.notes) %>
              </div>
            <% end %>

          </div>
        <% end %>

      </section>
    <% end %>

  <% end %>
</body>
</html>
